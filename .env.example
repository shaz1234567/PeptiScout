# OpenAI — GPT-4o baseline, GPT-4o-Vision (POST /api/analyze-bloodwork), embeddings, dataset generation
OPENAI_API_KEY=your_key_here

# Pinecone — RAG vector database (POST /api/rag, Tool B)
PINECONE_API_KEY=your_key_here
PINECONE_INDEX_NAME=peptiscout
# After changing ingestion, re-run: python -m backend.scripts.generate_dataset --phase pinecone
# so vectors include chunk text in metadata for retrieval.

# Tavily — vendor COA and Reddit source vetting (POST /api/vetting, Tool D)
TAVILY_API_KEY=your_key_here

# NCBI — PubMed abstract fetching (email only, no key needed)
NCBI_EMAIL=your_email_here

# Fine-tuned Llama + LoRA (POST /api/query mode=fine-tuned) — optional path; default is backend/models/peptide_lora_adapter/
LORA_ADAPTER_PATH=

# Hugging Face — only if Hub blocks model download (some Llama checkpoints); optional
# HF_TOKEN=your_token_here
